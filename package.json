{
  "name": "pmp-mvp",
  "private": true,
  "version": "0.0.0",
  "description": "ParkOS MVP monorepo (PlanMyParking)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check:repo": "node scripts/check-repo.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:scripts": "node --test scripts/check-migrations.test.mjs scripts/test-db.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "check": "pnpm check:repo && pnpm check:migrations && pnpm test:scripts && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
