{
  "name": "pmp-mvp",
  "private": true,
  "version": "0.0.0",
  "description": "ParkOS MVP monorepo (PlanMyParking)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check:repo": "node scripts/check-repo.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:bundles": "node scripts/check-client-bundles.mjs",
    "test:scripts": "node --test scripts/check-migrations.test.mjs scripts/test-db.test.mjs scripts/rehearse-forward.test.mjs scripts/gen-event-parity.test.mjs scripts/check-client-bundles.test.mjs scripts/seed-demo.test.mjs scripts/deploy-preflight.test.mjs scripts/deploy-workflows.test.mjs scripts/verify-ci-checks.test.mjs supabase/functions/send_report_email/reportJob.test.mjs",
    "test:pilot": "node --test field/cons12/roi.test.mjs ops/metrics/pilot-metrics.test.mjs",
    "gen:event-parity": "node scripts/gen-event-parity.mjs --write",
    "test:db": "node scripts/test-db.mjs",
    "test:db:ci": "node scripts/test-db-ci.mjs",
    "rehearse:forward": "node scripts/rehearse-forward.mjs",
    "test:db:concurrency": "node scripts/test-db-concurrency.mjs",
    "test:restore": "node --test tools/restore/restore_drill.test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "check": "pnpm check:repo && pnpm check:migrations && pnpm test:scripts && pnpm test:pilot && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundles console",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-gcqx-w48m-w2h4",
        "GHSA-fc5q-39xc-vjpf"
      ]
    },
    "overrides": {
      "uuid@<11.1.1": "11.1.1",
      "node-forge@<1.4.3": "1.4.3",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "glob@>=9.0.0 <14.0.2": "14.0.2"
    }
  }
}
