# Copy this file to the file named in the comment next to each group. NEVER commit real values.
# Nothing here is needed to run `pnpm check` today (no app reads these yet); the variables below are
# the PLANNED set from docs/team (Supabase, Resend, Sentry). Update this file when an app starts reading one.
#
# Where values live:
#   local development -> your untracked .env.local / app env file
#   CI                -> GitHub Actions secrets (none are used by CI yet)
#   production        -> Vercel / Supabase / EAS project settings, never this repository
#
# Values marked SERVER-ONLY must never reach a browser or the Android app bundle.

# --- Required for local development once apps/supabase exist ---
# Supabase project URL and public (anon) key. Use the DEV project, not production.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=replace-me
# Console (Next.js, .env.local). NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Gate app (Expo). EXPO_PUBLIC_ values are bundled into the APK.
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# --- SERVER-ONLY: Edge Functions, CI and migrations, never apps/gate or browser code ---
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Planned CI/deployment values; not consumed by the current CI workflow ---
# Project references are identifiers, not credentials. Keep each environment separate.
SUPABASE_PROJECT_REF=your-dev-project-ref
# Store these in environment-scoped GitHub secrets; do not use in client apps.
SUPABASE_ACCESS_TOKEN=replace-me
SUPABASE_DB_PASSWORD=replace-me
# Server-only secret for the report route (owner and runtime store to be confirmed).
REPORT_ROUTE_SECRET=replace-me

# --- Optional integrations ---
# Email reports (Resend), SERVER-ONLY
RESEND_API_KEY=replace-me
# Error tracking (Sentry). SENTRY_AUTH_TOKEN is CI-only (source map upload).
SENTRY_DSN=replace-me
SENTRY_AUTH_TOKEN=replace-me
