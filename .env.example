# Copy to .env.local (console) / app env (gate). NEVER commit real values.
# Values marked SERVER-ONLY must never reach a client bundle or the gate app.

# Supabase (project region: Mumbai)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SERVER-ONLY (Edge Functions / CI), never in apps/gate

# Console (Next.js; NEXT_PUBLIC_ vars are visible to browsers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gate app (Expo; EXPO_PUBLIC_ vars are bundled into the APK)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Email (Resend) - SERVER-ONLY
RESEND_API_KEY=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                # CI only
